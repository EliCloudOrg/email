# 复制为 .env.local（本地）或写入服务器 /srv/email/app.env（生产），不要提交。
# 生产 PUBLIC_BASE_URL 用 https://146.56.237.33/email；本地用 http://127.0.0.1:8010。

# ---- 对外地址 -------------------------------------------------------------
PUBLIC_BASE_URL=http://127.0.0.1:8010
APP_NAME=EliCloud

# ---- 存储 ---------------------------------------------------------------
# 本地用 sqlite:///./data/email.db；容器内用 sqlite:////data/email.db
DATABASE_URL=sqlite:///./data/email.db

# ---- 内部鉴权 / callback 签名（生产用 openssl rand -hex 32 生成） ----------
EMAIL_INTERNAL_TOKEN=change-me-to-a-random-32-byte-token-000000
CALLBACK_SIGNING_SECRET=change-me-to-a-random-32-byte-secret-0000
CALLBACK_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- 邮件 ---------------------------------------------------------------
# log：只写日志（本地/首次联调）；smtp：真实发信
MAIL_MODE=log
MAIL_FROM=no-reply@elipese.cloud
MAIL_FROM_NAME=EliCloud
# 生产直连 Resend 时：
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=<从服务器 /etc/postfix/sasl_passwd 安全提取，不要提交/打印>
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SMTP_TIMEOUT=10

# ---- 验证请求 -----------------------------------------------------------
VERIFICATION_TTL_SECONDS=900
MAX_ACTIVE_PER_EMAIL=3
CREATE_COOLDOWN_SECONDS=60
CONFIRM_RATE_LIMIT_PER_MINUTE=10
METADATA_MAX_BYTES=8192
ALLOWED_TEMPLATES=default,register

# ---- Callback -----------------------------------------------------------
CALLBACK_MAX_ATTEMPTS=6
CALLBACK_RETRY_SCHEDULE=0,30,120,600,3600,21600
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_ON_EXPIRY=true

# ---- Worker / 清理 ------------------------------------------------------
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=5
RETENTION_DAYS=30

# ---- 代理 / 日志 ---------------------------------------------------------
TRUST_PROXY_HEADERS=false
LOG_LEVEL=info
